[watch]
# Kodak Capture Pro Searchable PDF output folder.
# Edit this path to match your branch PC, then rename this file to settings.ini
folder = C:\Users\PolokwaneAdmin\Documents\IMPORTANT DOCMENTS\SCANNING\POD SCANS\PODS
# Watch dated subfolders (2026\08\180826\ etc.)
recursive = true

[processing]
# false = leave batch PDFs in the Kodak folder (recommended — no Capture Pro changes)
archive_source = false
# false = ignore PDFs already in Kodak folders (old manually-split files).
#         Only split NEW batch PDFs created after the splitter starts.
#         Required when switching from manual split to one-big-PDF output.
process_existing = false
